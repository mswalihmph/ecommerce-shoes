<div class="w-[50%] ml-10 mt-10 border-blue-300 border-4 text-center">
    <div class="p-6 flex ">
        <div class="img">
            <img id="pimg" src="/images/productImages/{{product._id}}.jpg" alt="image">
        </div>
        <div class="addr ">
            <h1 class=" font-serif font-black">FILL YOUR PRODUCT DETAILS</h1>
            <form class="w-[70%]" action="/admin/changeProduct" method="post" enctype="multipart/form-data">
                <div>
                    <label class="block" for="pname">Name Of Product</label>
                    <input class=" border-blue-300 border-2 pl-3" id="pname" name="pname" value={{product.pname}}'' type="text">
                </div>
                <div class="flex">
                    <div class="flex-col">
                        <label for="catogory">Catogory</label>
                        <input class=" border-blue-300 border-2 pl-3" id="catogory" value='{{product.catogory}}' name="catogory" type="text">
                    </div>
                    <div class="flex-col">
                        <label for="price">Price</label>
                        <input class=" border-blue-300 border-2 pl-3" id="price" value='{{product.price}}' name="price" type="number">
                    </div>
                </div>
                <div>
                    <label class="block" for="discription">Discription</label>
                    <input class=" border-blue-300 border-2 pl-3" id="discription" name="discription" value='{{product.discription}}' type="text">
                </div>
                <div class="mt-5">
                    <label class="block" for="files">Chose A file</label>
                    <input class="mt-5" id="files" name="files" type="file" onchange="fileChange(event)">
                </div>
                <DIv><button type="submit" class="p-2 bg-orange-200 border-blue-300 border-2 rounded-lg px-9 mt-5">competed</button></DIv>
                <input type="" value="{{product._id}}" name="id" class="hidden">

            </form>
        </div>
    </div>
</div>